<VirtualHost *:{{ http_port }}>
    ServerName {{ domain }}
    DocumentRoot "{{ document_root }}"

    {% if project_type == 'static_php' %}
    DirectoryIndex index.php index.html
    {% else %}
    DirectoryIndex index.html
    {% endif %}

    ErrorLog "{{ error_log_path }}"
    CustomLog "{{ access_log_path }}" common

    <Directory "{{ document_root }}">
        Options Indexes FollowSymLinks MultiViews
        AllowOverride All
        Require all granted
    </Directory>

    {% if project_type == 'proxy' %}

    ProxyRequests Off
    ProxyPreserveHost On
    ProxyPass / http://127.0.0.1:{{ app_port }}/
    ProxyPassReverse / http://127.0.0.1:{{ app_port }}/

    {% elif project_type == 'static_php' %}

    <FilesMatch \.php$>
        SetHandler "proxy:fcgi://{{ php_fpm_socket }}/"
    </FilesMatch>
    ProxyFCGISetEnvIf "true" SCRIPT_FILENAME "{{ document_root }}%{reqenv:SCRIPT_NAME}"
    {% endif %}

</VirtualHost>

{% if is_ssl_enabled %}
<IfModule mod_ssl.c>
    <VirtualHost *:{{ ssl_port }}>
        ServerName {{ domain }}
        DocumentRoot "{{ document_root }}"

        {% if project_type == 'static_php' %}
        DirectoryIndex index.php index.html
        {% else %}
        DirectoryIndex index.html
        {% endif %}

        ErrorLog "{{ error_log_path }}"
        CustomLog "{{ access_log_path }}" common

        SSLEngine on
        SSLCertificateFile "{{ ssl_certificate_path }}"
        SSLCertificateKeyFile "{{ ssl_key_path }}"

        <Directory "{{ document_root }}">
            Options Indexes FollowSymLinks MultiViews
            AllowOverride All
            Require all granted
        </Directory>

        {% if project_type == 'proxy' %}

        ProxyRequests Off
        ProxyPreserveHost On
        ProxyPass / http://127.0.0.1:{{ app_port }}/
        ProxyPassReverse / http://127.0.0.1:{{ app_port }}/

        {% elif project_type == 'static_php' %}

        <FilesMatch \.php$>
            SetHandler "proxy:fcgi://{{ php_fpm_socket }}/"
        </FilesMatch>
        ProxyFCGISetEnvIf "true" SCRIPT_FILENAME "{{ document_root }}%{reqenv:SCRIPT_NAME}"
        {% endif %}

    </VirtualHost>
</IfModule>
{% endif %}